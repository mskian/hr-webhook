[Unit]
Description=Uvicorn instance to serve for HR data
Requires=network.target
After=network.target

[Service]
WorkingDirectory=/home/hr
Environment="PATH=/home/hr/venv/bin"
ExecStart=/home/hr/venv/bin/uvicorn app:app \
  --host 0.0.0.0 \
  --port 2603 \
  --workers 2 \
  --loop uvloop \
  --http httptools \
  --ws wsproto \
  --ws-ping-interval 20 \
  --ws-ping-timeout 20 \
  --lifespan on \
  --proxy-headers \
  --forwarded-allow-ips='*' \
  --no-access-log
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target